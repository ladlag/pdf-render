# Example Spring Boot configuration for pdf-render library
# Place this in your Spring Boot project's src/main/resources/application.yml

pdf-render:
  # Template configuration
  template:
    # Location of template files (default: classpath:/templates/)
    location: classpath:/templates/
    # Default template name without .html extension (default: report)
    default-name: report
    # Whether to cache templates for better performance (default: true)
    # Set to false in development for hot reload
    cache-enabled: true
  
  # Output configuration
  output:
    # Directory for generated PDF files (optional)
    # If not set, PDFs are only returned as byte arrays
    directory: /var/pdfs
    # Whether to automatically save PDFs to the directory (default: false)
    save-to-directory: false
  
  # Font configuration for Chinese/Japanese/Korean (CJK) text support
  # See FONT_CONFIGURATION.md for detailed guide
  fonts:
    # Path to custom regular font file for Chinese text
    # Download: https://github.com/googlefonts/noto-cjk (Noto Sans CJK)
    # Or use: HarmonyOS Sans SC from https://developer.harmonyos.com
    regular-path: classpath:/fonts/HarmonyOS_SansSC_Regular.ttf
    
    # Path to custom bold font file for Chinese text
    bold-path: classpath:/fonts/HarmonyOS_SansSC_Bold.ttf
    
    # Alternative: Noto Sans CJK (Google's open source font)
    # regular-path: classpath:/fonts/NotoSansCJKsc-Regular.otf
    # bold-path: classpath:/fonts/NotoSansCJKsc-Bold.otf
    
    # Default font family CSS (used when fonts are configured)
    # This will be used in the CSS font-family property
    default-family: HarmonyOS Sans SC, Noto Sans CJK SC, DejaVu Sans, Arial, sans-serif
    
    # Note: Without custom fonts, Chinese characters may appear as boxes (□)
    # Place your font files in src/main/resources/fonts/ directory
